{
  "openapi": "3.0.0",
  "info": {
    "title": "E-Commerce Backend API",
    "version": "1.0.0",
    "description": "Comprehensive interactive API documentation for User Authentication, Role-Based Access Control, Product Catalog, and CSV Import/Export."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT token obtained from /api/users/login or /api/users/register"
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Health Check",
        "tags": ["General"],
        "responses": {
          "200": {
            "description": "Server is up and running"
          }
        }
      }
    },
    "/api/users/register": {
      "post": {
        "summary": "Register a new user",
        "tags": ["Users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string", "example": "Venkat Sreekar" },
                  "email": { "type": "string", "example": "venkat@example.com" },
                  "password": { "type": "string", "example": "password123" },
                  "role": { "type": "string", "enum": ["user", "admin"], "example": "user" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered successfully" },
          "400": { "description": "Validation error or user already exists" }
        }
      }
    },
    "/api/users/login": {
      "post": {
        "summary": "Authenticate user & get JWT token",
        "tags": ["Users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "venkat@example.com" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful with JWT token" },
          "401": { "description": "Invalid email or password" }
        }
      }
    },
    "/api/users/profile": {
      "get": {
        "summary": "Get current user profile",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Profile retrieved successfully" },
          "401": { "description": "Unauthorized" }
        }
      },
      "put": {
        "summary": "Update current user profile",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Venkat Updated" },
                  "email": { "type": "string", "example": "venkat.updated@example.com" },
                  "password": { "type": "string", "example": "newpassword123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile updated successfully" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/users": {
      "get": {
        "summary": "View all users (Admin Only)",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of all users" },
          "403": { "description": "Access denied. Admin access required." }
        }
      }
    },
    "/api/users/{id}": {
      "delete": {
        "summary": "Delete user by ID (Admin Only)",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "User MongoDB ID"
          }
        ],
        "responses": {
          "200": { "description": "User deleted successfully" },
          "403": { "description": "Access denied. Admin access required." },
          "404": { "description": "User not found" }
        }
      }
    },
    "/api/products": {
      "get": {
        "summary": "Get products with filtering, sorting & pagination",
        "description": "Normal users receive only published=true products. Admins receive all products.",
        "tags": ["Products"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "category", "in": "query", "schema": { "type": "string" }, "example": "Mobile" },
          { "name": "minPrice", "in": "query", "schema": { "type": "number" }, "example": 20000 },
          { "name": "maxPrice", "in": "query", "schema": { "type": "number" }, "example": 80000 },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["price_asc", "price_desc", "newest"] }, "example": "price_asc" },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "example": 1 },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 }, "example": 10 }
        ],
        "responses": {
          "200": { "description": "Products fetched successfully" }
        }
      },
      "post": {
        "summary": "Create a new product (Admin Only)",
        "tags": ["Products"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "description", "price", "category", "stock"],
                "properties": {
                  "name": { "type": "string", "example": "iPhone 17" },
                  "description": { "type": "string", "example": "Latest Apple smartphone" },
                  "price": { "type": "number", "example": 80000 },
                  "category": { "type": "string", "example": "Mobile" },
                  "stock": { "type": "integer", "example": 20 },
                  "published": { "type": "boolean", "default": false, "example": false }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Product created successfully" },
          "403": { "description": "Access denied. Admin access required." }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "summary": "Get product by ID",
        "tags": ["Products"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Product retrieved" },
          "404": { "description": "Product not found" }
        }
      },
      "put": {
        "summary": "Update product by ID (Admin Only)",
        "tags": ["Products"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "price": { "type": "number", "example": 75000 },
                  "stock": { "type": "integer", "example": 15 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Product updated successfully" },
          "403": { "description": "Access denied. Admin access required." }
        }
      },
      "delete": {
        "summary": "Delete product by ID (Admin Only)",
        "tags": ["Products"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Product deleted successfully" },
          "403": { "description": "Access denied. Admin access required." }
        }
      }
    },
    "/api/products/{id}/publish": {
      "patch": {
        "summary": "Publish a product (Admin Only)",
        "tags": ["Products"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Product published successfully" },
          "403": { "description": "Access denied. Admin access required." }
        }
      }
    },
    "/api/products/{id}/unpublish": {
      "patch": {
        "summary": "Unpublish a product (Admin Only)",
        "tags": ["Products"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Product unpublished successfully" },
          "403": { "description": "Access denied. Admin access required." }
        }
      }
    },
    "/api/products/import": {
      "post": {
        "summary": "Import products from CSV file (Admin Only)",
        "tags": ["Products"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Upload a products .csv file"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Products imported successfully" },
          "403": { "description": "Access denied. Admin access required." }
        }
      }
    },
    "/api/products/export": {
      "get": {
        "summary": "Export products to downloadable CSV file (Admin Only)",
        "tags": ["Products"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Downloadable CSV file",
            "content": {
              "text/csv": {
                "schema": { "type": "string" }
              }
            }
          },
          "403": { "description": "Access denied. Admin access required." }
        }
      }
    }
  }
}
